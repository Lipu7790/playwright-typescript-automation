{
  "name": "playwright-typescript-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E and API automation framework (Page Object Model) by Md. Motiur Rahman Lipu",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "author": "Md. Motiur Rahman Lipu",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
